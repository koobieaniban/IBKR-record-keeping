# Postgres connection string (Supabase or local dev)
DATABASE_URL="postgresql://user:password@localhost:5432/ibkr_dev?schema=public"

# Password gate for the whole app (see src/proxy.ts). Leave unset locally to skip auth;
# ALWAYS set this in production, since the dashboard shows real trade/P&L data.
APP_PASSWORD=""

# Only needed by worker/ingest-daily.ts (the production cron worker) —
# from IBKR Client Portal: Settings > Flex Web Service (token) and
# Performance & Reports > Flex Queries (query ID). Never commit real values.
IBKR_FLEX_TOKEN=""
IBKR_FLEX_QUERY_ID=""
